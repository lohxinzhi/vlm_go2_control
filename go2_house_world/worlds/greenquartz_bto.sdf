<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <world name="greenquartz_bto">
    <physics name="1ms" type="bullet-featherstone">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='go2_house_world::OrthographicCameraSystem'
            filename='liborthographic_camera_system.so'>
      <sensor_name>top_down_camera</sensor_name>
      <view_width>36</view_width>
      <view_height>24</view_height>
    </plugin>

    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat">
    </plugin>    

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>30.0444</latitude_deg>
      <longitude_deg>31.2357</longitude_deg>
      <elevation>74.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.75 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 -1 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <model name="greenquartz_bto">
      <static>true</static>
      <pose>0 0 -0.02 0 0 0</pose>
      <link name="apartment">
        <!--
          Uniform house mesh scale. The source model uses 0.01, so 0.02 is 2x.
          Change all three matching values in both scale elements together.
        -->
        <visual name="fusion_visual">
          <geometry>
            <mesh>
              <uri>model://greenquartz_bto/meshes/GreenQuartz_BTO.obj</uri>
              <scale>0.02 0.02 0.02</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="fusion_collision">
          <geometry>
            <mesh>
              <uri>model://greenquartz_bto/meshes/GreenQuartz_BTO.obj</uri>
              <scale>0.02 0.02 0.02</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <model name='top_down_camera'>
      <static>true</static>
      <!-- The camera looks straight down and covers the 30 m by 20 m apartment. -->
      <pose>14.8 5.8 16 0 1.570796 1.570796</pose>
      <link name='camera_link'>
        <sensor name='top_down_camera' type='camera'>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <topic>/top_down/image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>1200</width>
              <height>800</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <include>
      <uri>model://target_green_cube_living_room</uri>
      <name>target_green_cube_living_room</name>
      <pose>6.2 12.2 0.61 0 0 0</pose>
    </include>
    <include>
      <uri>model://target_red_triangle_bedroom1</uri>
      <name>target_red_triangle_bedroom1</name>
      <pose>14 11.6 0.71 0 0 0</pose>
